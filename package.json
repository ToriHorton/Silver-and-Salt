{
  "name": "silver-and-salt",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": { "node": "24.13.0", "npm": "11.6.2" },
  "scripts": {
    "pretest": "node scripts/verify-dev-dependencies.mjs",
    "prebuild": "node scripts/verify-dev-dependencies.mjs",
    "lock:update": "node scripts/dev-lock.mjs update",
    "lock:verify": "node scripts/dev-lock.mjs verify",
    "test": "vitest run",
    "dev": "python3 -m http.server 3000",
    "build": "bash _scripts/build-site.sh",
    "dev:worker": "npm run build && wrangler dev --env dev",
    "deploy:app:dev": "node _scripts/assert-dev-deploy-target.mjs && npm run build && wrangler deploy --env dev",
    "check:schema": "node _scripts/check-deployed-schema.mjs"
  },
  "devDependencies": {
    "@odla-ai/cli": "^0.57.6",
    "@odla-ai/security": "0.3.1",
    "@preact/preset-vite": "^2.10.5",
    "preact-render-to-string": "^6.7.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@odla-ai/auth-clerk": "^0.4.1",
    "@odla-ai/calendar": "^0.3.0",
    "@odla-ai/chapter": "file:vendor/odla-ai-chapter-0.47.11-private-a19568ff.tgz",
    "@odla-ai/crm": "file:vendor/odla-ai-crm-0.9.2-private-1f45e8f2.tgz",
    "@odla-ai/db": "^0.9.1",
    "@odla-ai/email": "^0.3.1",
    "@odla-ai/stripe": "file:vendor/odla-ai-stripe-0.1.1.tgz",
    "@odla-ai/ui": "^0.20.0",
    "jose": "^6.2.4",
    "preact": "^10.29.7"
  },
  "overrides": {
    "browserslist": "4.28.8"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260710.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true,
    "@google/genai@1.52.0": true
  }
}
