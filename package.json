{
  "name": "silver-and-salt",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "python3 -m http.server 3000",
    "build": "bash _scripts/build-site.sh",
    "dev:worker": "npm run build && wrangler dev --env dev",
    "deploy:app:dev": "node _scripts/assert-dev-deploy-target.mjs && npm run build && wrangler deploy --env dev",
    "check:schema": "node _scripts/check-deployed-schema.mjs",
    "deploy:app:staging": "npm run build && npx wrangler deploy --env staging",
    "assert:prod-target": "node _scripts/assert-prod-deploy-target.mjs",
    "security:scan": "odla-security scan . --profile odla --out .odla/security/latest --fail-on high --fail-on-candidates critical --exclude Silver-and-Salt-Capital-FAQ.pdf --exclude report-headers.numbers --exclude report-headers.xlsx"
  },
  "devDependencies": {
    "@odla-ai/cli": "0.61.2",
    "@odla-ai/security": "0.3.3",
    "@preact/preset-vite": "^2.10.5",
    "preact-render-to-string": "^6.7.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@odla-ai/auth-clerk": "0.5.0",
    "@odla-ai/calendar": "0.3.0",
    "@odla-ai/chapter": "0.54.0",
    "@odla-ai/crm": "0.10.0",
    "@odla-ai/db": "0.14.0",
    "@odla-ai/email": "0.3.1",
    "@odla-ai/o11y": "2.6.0",
    "@odla-ai/stripe": "0.1.1",
    "@odla-ai/ui": "0.20.0",
    "jose": "^6.2.4",
    "preact": "^10.29.7"
  },
  "overrides": {
    "browserslist": "4.28.8"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true,
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.6": true,
    "workerd@1.20260831.1": true
  }
}
